# macOS
.DS_Store

# Build output
build/
DerivedData/

# Xcode per-developer state (window layout, breakpoints, selected scheme) —
# not meant to be shared between machines
xcuserdata/
*.xcuserstate

# Swift Package Manager (unused here, but harmless to have ready)
.build/
.swiftpm/

# Generated by `xcode-build-server config` — bakes in a machine-specific
# absolute path, regenerate with:
#   xcode-build-server config -project Chomp.xcodeproj -scheme Chomp
buildServer.json

# XcodeGen output; regenerate from project.yml
*.xcodeproj/

# Release artifacts
dist/
