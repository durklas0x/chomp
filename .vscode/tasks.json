{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Chomp",
      "type": "shell",
      "command": "${workspaceFolder}/Scripts/build.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "swift",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (warning|error): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Run Chomp",
      "type": "shell",
      "command": "open",
      "args": [
        "${workspaceFolder}/build/Build/Products/Debug/Chomp.app"
      ],
      "dependsOn": [
        "Build Chomp"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Chomp",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-scheme",
        "Chomp",
        "-derivedDataPath",
        "build",
        "clean"
      ],
      "problemMatcher": []
    }
  ]
}
